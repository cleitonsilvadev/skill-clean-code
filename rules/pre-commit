#!/usr/bin/env bash

# Clean Code Pre-Commit Hook
# Checks staged changes for common anti-patterns before committing.

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null || true)

if [ -z "$STAGED_FILES" ]; then
  exit 0
fi

DEBUG_PATTERNS="console\.log\(|debugger;|breakpoint\(\)|pdb\.set_trace\(\)"
CODE_FILES=$(echo "$STAGED_FILES" | grep -E '\.(ts|js|tsx|jsx|py|go|rs)$' | grep -v -E '(\.test\.|\.spec\.|__tests__|test/|tests/)' || true)

WARNINGS=0

if [ -n "$CODE_FILES" ]; then
  for file in $CODE_FILES; do
    if [ -f "$file" ]; then
      MATCHES=$(git diff --cached "$file" | grep -E '^\+[^+]' | grep -E "$DEBUG_PATTERNS" || true)
      if [ -n "$MATCHES" ]; then
        echo -e "\033[1;33m[clean-code warning]\033[0m Potential debug statement found in $file:"
        echo "$MATCHES" | head -n 3
        WARNINGS=$((WARNINGS + 1))
      fi
    fi
  done
fi

if [ "$WARNINGS" -gt 0 ]; then
  echo -e "\033[1;33m[clean-code]\033[0m Staged files contain $WARNINGS debug statement(s). Use --no-verify to bypass if intentional."
fi

exit 0
